# Copie estas configuracoes para o .env da raiz ou para o ambiente do EasyPanel.
GCP_PROJECT_ID=casa-das-maquinas
BIGQUERY_DATASET_ID=casa_maquinas
BIGQUERY_TABLE_ID=tb_indicadores_diarios
BIGQUERY_RAW_TABLE_ID=casa_maquina_bruto
BIGQUERY_LOCATION=southamerica-east1
BIGQUERY_MAXIMUM_BYTES_BILLED=104857600
BIGQUERY_QUERY_TIMEOUT=120

# EasyPanel: Base64 do JSON completo da conta de servico, em uma unica linha.
# Tambem aceita JSON direto, caminho de arquivo JSON ou chave PEM.
GOOGLE_APPLICATION_CREDENTIALS=
# Estes campos sao necessarios somente para uma chave PEM sem JSON completo.
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_TOKEN_URI=https://oauth2.googleapis.com/token

# Desenvolvimento local com PEM: metadados podem vir de um JSON local.
# GCP_SERVICE_ACCOUNT_FILE=casa-das-maquinas-a8aeb8e4800f.json

HOST=127.0.0.1
PORT=8505
DASH_URL_BASE_PATHNAME=/dashboard/
TRUST_PROXY=false
